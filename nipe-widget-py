#!/usr/bin/env python3
"""Nipe Control helper for DankMaterialShell.

Commands
--------
  json-status [--api URL] [--nipe-dir DIR] [--socks-port N]
      One JSON object on stdout, for the panel widget.
  status | start | stop | restart
      Run nipe.pl. start/stop/restart/status need root, so they go through
      pkexec and raise a polkit dialog. Nothing else does.
  check-deps
      Dependency report.
  path
      Resolved Nipe checkout.

Design
------
* Polling is unprivileged. nipe.pl refuses to run status as a non-root user,
  but the only thing status does is ask the Tor Project check endpoint whether
  the current connection is a Tor circuit. The widget asks the same endpoint
  through the local SOCKS port instead, so the panel learns "is Tor up" and
  "which exit node" in a single request and the user is never prompted just to
  look at the bar. If nothing is listening on the local SOCKS port the probe
  returns straight away without any network traffic, so an off gateway stays
  cheap to watch. pkexec is reserved for the actions that really need root.
* `error` is either JSON null or a plain message. It is never a pre-quoted
  string and never the literal text "null".
* Precedence for every setting: command line, then the config file
  (~/.config/nipeControl/config), then built-in defaults.
"""

import argparse
import http.client
import json
import logging
import os
import shlex
import shutil
import socket
import ssl
import struct
import subprocess
import sys
import time
from dataclasses import asdict, dataclass
from typing import Any, Dict, List, Optional, Tuple
from urllib.parse import urlsplit

VERSION = "3.1.0"
APP = "nipeControl"

DATA_DIR = os.path.expanduser("~/.local/share/nipeControl")
CONFIG_FILE = os.path.expanduser("~/.config/nipeControl/config")
LOG_FILE = os.path.join(DATA_DIR, "nipe-widget-py.log")
DEP_CACHE_FILE = os.path.join(DATA_DIR, "deps.json")
GEO_CACHE_FILE = os.path.join(DATA_DIR, "geo.json")

DEP_CACHE_TTL = 24 * 60 * 60
GEO_CACHE_TTL = 6 * 60 * 60
GEO_NEGATIVE_CACHE_TTL = 15 * 60
GEO_CACHE_MAX_ENTRIES = 128
HTTP_MAX_TIME = 5

NIPE_SEARCH_PATHS = (
    "~/nipe",
    "~/.local/share/nipe",
    "/opt/nipe",
    "/etc/nipe",
    "/usr/local/nipe",
)

REQUIRED_COMMANDS = ("perl",)
REQUIRED_PERL_MODULES = (
    "Config::Simple",
    "JSON",
    "Readonly",
    "Try::Tiny",
    "IO::Socket::SSL",
    "Net::SSLeay",
)
OPTIONAL_COMMANDS = ("pkexec",)


def _ensure_data_dir() -> bool:
    try:
        os.makedirs(DATA_DIR, exist_ok=True)
        return True
    except OSError:
        return False


_HAS_DATA_DIR = _ensure_data_dir()


def _setup_logging() -> logging.Logger:
    """Attach a file handler only when the data directory is usable."""
    handlers: List[logging.Handler] = []
    if _HAS_DATA_DIR:
        try:
            handlers.append(logging.FileHandler(LOG_FILE))
        except OSError:
            pass
    handlers.append(logging.StreamHandler(sys.stderr))
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s - %(levelname)s - %(message)s",
        handlers=handlers,
    )
    return logging.getLogger(APP)


logger = _setup_logging()


def _truthy(value: Any) -> bool:
    if isinstance(value, bool):
        return value
    return str(value).strip().lower() in ("true", "1", "yes", "on")


def _read_json_file(path: str) -> Dict[str, Any]:
    try:
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
        return data if isinstance(data, dict) else {}
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as exc:
        logger.warning("Could not read %s: %s", path, exc)
        return {}


def _write_json_file(path: str, data: Dict[str, Any]) -> None:
    tmp = f"{path}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(data, handle)
        os.replace(tmp, path)
    except OSError as exc:
        logger.warning("Could not write %s: %s", path, exc)
        try:
            os.unlink(tmp)
        except OSError:
            pass


def _clean_output(text: str, limit: int = 400) -> str:
    cleaned = " ".join(text.replace("\r", " ").split())
    if len(cleaned) > limit:
        cleaned = cleaned[: limit - 1].rstrip() + "…"
    return cleaned


def _read_exact(sock: socket.socket, count: int) -> bytes:
    data = bytearray()
    while len(data) < count:
        chunk = sock.recv(count - len(data))
        if not chunk:
            raise OSError("connection closed during SOCKS negotiation")
        data += chunk
    return bytes(data)


def _socks5_connect(
    proxy_host: str, proxy_port: int, host: str, port: int, timeout: float
) -> socket.socket:
    """Open host:port through a local SOCKS5 proxy (remote DNS, no auth)."""
    sock = socket.create_connection((proxy_host, proxy_port), timeout=timeout)
    try:
        sock.settimeout(timeout)
        sock.sendall(b"\x05\x01\x00")
        if _read_exact(sock, 2) != b"\x05\x00":
            raise OSError("SOCKS5 proxy rejected the connection")
        try:
            address = b"\x01" + socket.inet_aton(host)
        except OSError:
            name = host.encode("idna")
            address = b"\x03" + bytes((len(name),)) + name
        sock.sendall(b"\x05\x01\x00" + address + struct.pack("!H", port))
        reply = _read_exact(sock, 4)
        if reply[1] != 0:
            raise OSError(f"SOCKS5 proxy could not reach {host} (code {reply[1]})")
        if reply[3] == 1:
            _read_exact(sock, 4)
        elif reply[3] == 3:
            _read_exact(sock, _read_exact(sock, 1)[0])
        elif reply[3] == 4:
            _read_exact(sock, 16)
        _read_exact(sock, 2)
        return sock
    except BaseException:
        sock.close()
        raise


class _SocksHTTPConnection(http.client.HTTPConnection):
    """HTTP connection that reaches the destination through a SOCKS5 proxy."""

    def __init__(
        self,
        host: str,
        port: int,
        proxy_host: str,
        proxy_port: int,
        timeout: float,
    ):
        super().__init__(host, port, timeout=timeout)
        self._proxy_host = proxy_host
        self._proxy_port = proxy_port

    def connect(self) -> None:
        self.sock = _socks5_connect(
            self._proxy_host, self._proxy_port, self.host, self.port, self.timeout
        )


class _SocksHTTPSConnection(http.client.HTTPSConnection):
    """HTTPS connection that reaches the destination through a SOCKS5 proxy."""

    def __init__(
        self,
        host: str,
        port: int,
        proxy_host: str,
        proxy_port: int,
        timeout: float,
    ):
        super().__init__(host, port, timeout=timeout)
        self._proxy_host = proxy_host
        self._proxy_port = proxy_port

    def connect(self) -> None:
        raw = _socks5_connect(
            self._proxy_host, self._proxy_port, self.host, self.port, self.timeout
        )
        context = self._context or ssl.create_default_context()
        self.sock = context.wrap_socket(raw, server_hostname=self.host)


@dataclass
class NipeConfig:
    """Effective configuration for one invocation."""

    nipe_dir: str = ""
    ip_info_api: str = "https://ipinfo.io"
    tor_check_url: str = "https://check.torproject.org/api/ip"
    tor_socks_port: int = 9050
    config_file: str = CONFIG_FILE


@dataclass
class NipeStatus:
    """What the widget renders. `error` is None or a plain message."""

    active: bool = False
    ip: str = ""
    error: Optional[str] = None
    nipe_dir: str = ""
    country: str = ""
    country_code: str = ""
    city: str = ""
    region: str = ""
    source: str = ""

    def to_json(self) -> str:
        return json.dumps(asdict(self), indent=2)


class NipeWidgetPy:
    """Thin wrapper around nipe.pl plus the unprivileged status probe."""

    def __init__(self, config: Optional[NipeConfig] = None):
        self.config = config or NipeConfig()
        self.config = self._apply_config_file(self.config)
        self.nipe_dir = self._find_nipe_dir()

    # ------------------------------------------------------------------
    # Configuration
    # ------------------------------------------------------------------

    def _apply_config_file(self, config: NipeConfig) -> NipeConfig:
        """Overlay ~/.config/nipeControl/config. CLI values already win."""
        try:
            with open(config.config_file, "r", encoding="utf-8") as handle:
                lines = handle.readlines()
        except FileNotFoundError:
            return config
        except OSError as exc:
            logger.warning("Could not read %s: %s", config.config_file, exc)
            return config

        for line in lines:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, value = line.partition("=")
            key = key.strip().upper()
            value = value.strip().strip("\"'")
            if not value:
                continue
            if key == "NIPE_DIR" and not config.nipe_dir:
                config.nipe_dir = os.path.expanduser(value)
            elif key == "IP_INFO_API" and config.ip_info_api == NipeConfig.ip_info_api:
                config.ip_info_api = value.rstrip("/")
            elif key == "TOR_CHECK_URL" and config.tor_check_url == NipeConfig.tor_check_url:
                config.tor_check_url = value
            elif key == "TOR_SOCKS_PORT" and config.tor_socks_port == NipeConfig.tor_socks_port:
                try:
                    config.tor_socks_port = int(value)
                except ValueError:
                    logger.warning("Ignoring invalid TOR_SOCKS_PORT=%s", value)
        return config

    def _find_nipe_dir(self) -> str:
        """An explicit setting wins outright; otherwise scan known locations.

        If the user named a directory we do not fall back to another checkout -
        silently controlling a different install than the one they pointed at
        would be worse than telling them it is missing.
        """
        if self.config.nipe_dir:
            return self.config.nipe_dir if self._validate_nipe_dir(self.config.nipe_dir) else ""

        for path in NIPE_SEARCH_PATHS:
            expanded = os.path.expanduser(path)
            if self._validate_nipe_dir(expanded):
                return expanded
        return ""

    def _validate_nipe_dir(self, path: str) -> bool:
        return os.path.isdir(path) and os.path.isfile(os.path.join(path, "nipe.pl"))

    # ------------------------------------------------------------------
    # Dependencies
    # ------------------------------------------------------------------

    def check_dependencies(self, use_cache: bool = True) -> Tuple[List[str], List[str]]:
        """Return (missing, optional_missing).

        The Perl module probe is a single interpreter start instead of one per
        module, and the verdict is cached for a day because the answer only
        changes when the user installs something.
        """
        if use_cache and _HAS_DATA_DIR:
            cached = _read_json_file(DEP_CACHE_FILE)
            ts = float(cached.get("ts", 0))
            if ts and (time.time() - ts) < DEP_CACHE_TTL:
                return list(cached.get("missing", [])), list(cached.get("optional_missing", []))

        missing = [cmd for cmd in REQUIRED_COMMANDS if not shutil.which(cmd)]
        if shutil.which("perl") and not self._perl_modules_ok(REQUIRED_PERL_MODULES):
            for module in REQUIRED_PERL_MODULES:
                if not self._perl_modules_ok((module,)):
                    missing.append(f"perl-{module.lower()}")
        optional_missing = [cmd for cmd in OPTIONAL_COMMANDS if not shutil.which(cmd)]

        if use_cache and _HAS_DATA_DIR:
            _write_json_file(
                DEP_CACHE_FILE,
                {
                    "ts": time.time(),
                    "missing": missing,
                    "optional_missing": optional_missing,
                },
            )
        return missing, optional_missing

    def _perl_modules_ok(self, modules: Tuple[str, ...]) -> bool:
        code = "; ".join(f"use {module} ();" for module in modules) + " 1;"
        try:
            result = subprocess.run(
                ["perl", "-e", code],
                capture_output=True,
                text=True,
                timeout=30,
            )
        except (OSError, subprocess.TimeoutExpired):
            return False
        if result.returncode != 0:
            logger.debug("Perl module check failed: %s", _clean_output(result.stderr, 200))
        return result.returncode == 0

    # ------------------------------------------------------------------
    # Status (never elevates)
    # ------------------------------------------------------------------

    def _http_json(
        self,
        url: str,
        socks_host: str = "",
        max_time: int = HTTP_MAX_TIME,
    ) -> Tuple[Optional[Dict[str, Any]], Optional[str]]:
        """GET a JSON document with the standard library. Returns (data, error).

        Uses the platform TLS trust store and, when `socks_host` is given, a
        local SOCKS5 proxy (remote DNS) for the Tor check. Keeping this in
        python removes the separate downloader dependency.
        """
        parts = urlsplit(url)
        if parts.scheme not in ("http", "https") or not parts.hostname:
            return None, f"unsupported URL: {url}"
        host = parts.hostname
        port = parts.port or (443 if parts.scheme == "https" else 80)
        path = parts.path or "/"
        if parts.query:
            path = f"{path}?{parts.query}"

        if socks_host:
            proxy_host, _, proxy_port = socks_host.partition(":")
            try:
                proxy_port_i = int(proxy_port or 1080)
            except ValueError:
                return None, f"invalid SOCKS address: {socks_host}"
            factory = (
                _SocksHTTPSConnection if parts.scheme == "https" else _SocksHTTPConnection
            )
            conn: http.client.HTTPConnection = factory(
                host, port, proxy_host, proxy_port_i, max_time
            )
        elif parts.scheme == "https":
            conn = http.client.HTTPSConnection(host, port, timeout=max_time)
        else:
            conn = http.client.HTTPConnection(host, port, timeout=max_time)

        try:
            conn.request(
                "GET",
                path,
                headers={"User-Agent": f"{APP}/{VERSION}", "Accept": "application/json"},
            )
            response = conn.getresponse()
            status = response.status
            body = response.read()
        except (OSError, http.client.HTTPException, ssl.SSLError) as exc:
            return None, _clean_output(str(exc), 160)
        finally:
            conn.close()

        if status != 200:
            return None, f"{host} returned HTTP {status}"

        try:
            data = json.loads(body.decode("utf-8", "replace"))
        except ValueError:
            return None, f"{url} did not return JSON"
        if not isinstance(data, dict):
            return None, f"{url} returned an unexpected payload"
        return data, None

    def _socks_port_open(self) -> bool:
        """Cheap local check so an off gateway never costs a network request."""
        try:
            with socket.create_connection(
                ("127.0.0.1", self.config.tor_socks_port), timeout=0.5
            ):
                return True
        except OSError:
            return False

    def probe_tor(self) -> Tuple[bool, str, Optional[str]]:
        """Ask the Tor check endpoint through SOCKS. Returns (active, ip, error).

        Nothing listening on the local SOCKS port means no Tor circuit is up,
        so the probe returns immediately without touching the network at all.
        That is what keeps the widget cheap while it is idle. When the port is
        open a SOCKS answer tells us a Tor circuit is reachable: if the local
        Tor instance answers, `IsTor` plus `IP` are the exit node. This is not
        proof that Nipe's redirect is installed, only that a circuit is up. Only
        when SOCKS is silent with the port still open do we fall back to a
        direct request to tell a Tor problem apart from a broken network.
        """
        if not self._socks_port_open():
            return False, "", None

        socks_host = f"127.0.0.1:{self.config.tor_socks_port}"
        url = self.config.tor_check_url

        data, socks_error = self._http_json(url, socks_host=socks_host)
        if data is not None:
            if _truthy(data.get("IsTor")):
                return True, str(data.get("IP") or ""), None
            return False, "", None

        data, direct_error = self._http_json(url)
        if data is not None:
            logger.info("Tor SOCKS unavailable (%s); direct check reports no Tor", socks_error)
            return False, "", None

        return (
            False,
            "",
            f"Tor check endpoint unreachable ({direct_error or socks_error}). Is the network up?",
        )

    def geolocate(self, ip: str, socks_host: str = "") -> Dict[str, str]:
        """ipinfo.io-style lookup for the exit IP, cached per IP.

        The lookup rides the same SOCKS circuit as the Tor check so the exit
        IP is never sent from the user's real address. When the circuit is
        down the lookup is skipped instead of falling back to a direct
        request, which would leak the address this plugin is meant to hide.
        """
        if not ip:
            return {}

        now = time.time()
        cache = _read_json_file(GEO_CACHE_FILE)
        entry = cache.get(ip)
        if isinstance(entry, dict):
            age = now - float(entry.get("ts", 0))
            if age < GEO_CACHE_TTL:
                return dict(entry.get("data", {}))
            if age < GEO_CACHE_TTL + GEO_NEGATIVE_CACHE_TTL and not entry.get("data"):
                return {}

        url = f"{self.config.ip_info_api.rstrip('/')}/{ip}/json"
        data, error = self._http_json(url, socks_host=socks_host)
        if not data or not data.get("country"):
            logger.warning("Geolocation failed for %s: %s", ip, error)
            if len(cache) < GEO_CACHE_MAX_ENTRIES:
                cache[ip] = {"ts": now, "data": {}}
                _write_json_file(GEO_CACHE_FILE, cache)
            return {}

        code = str(data.get("country") or "")
        info = {
            "country_code": code,
            "country": str(data.get("country_name") or data.get("name") or code),
            "city": str(data.get("city") or ""),
            "region": str(data.get("region") or ""),
        }
        if len(cache) >= GEO_CACHE_MAX_ENTRIES:
            cache.pop(next(iter(cache)), None)
        cache[ip] = {"ts": now, "data": info}
        if _HAS_DATA_DIR:
            _write_json_file(GEO_CACHE_FILE, cache)
        return info

    def get_json_status(self) -> NipeStatus:
        """The widget's whole world. Unprivileged, no polkit prompt."""
        status = NipeStatus(nipe_dir=self.nipe_dir)

        active, ip, error = self.probe_tor()
        status.active = active
        status.source = "tor"
        if error:
            status.error = error
            return status
        if not active:
            return status

        status.ip = ip
        if ip:
            socks_host = f"127.0.0.1:{self.config.tor_socks_port}"
            info = self.geolocate(ip, socks_host=socks_host)
            status.country_code = info.get("country_code", "")
            status.country = info.get("country", "")
            status.city = info.get("city", "")
            status.region = info.get("region", "")
        return status

    # ------------------------------------------------------------------
    # Elevated actions
    # ------------------------------------------------------------------

    def run_nipe_cmd(self, action: str) -> Tuple[bool, str]:
        """Run nipe.pl <action> as root via pkexec. Returns (ok, message)."""
        if not self.nipe_dir:
            return False, (
                "Nipe directory not found. Set NIPE_DIR or the plugin's directory setting."
            )

        missing, _ = self.check_dependencies()
        if missing:
            return False, f"Missing dependencies: {', '.join(missing)}"

        perl_bin = shutil.which("perl")
        if not perl_bin:
            return False, "perl is not installed"

        pkexec_bin = shutil.which("pkexec")
        if not pkexec_bin:
            return False, "pkexec not found. Install polkit to control the gateway."

        nipe_script = os.path.join(self.nipe_dir, "nipe.pl")
        # pkexec resets the working directory and nipe.pl resolves ./lib/ from
        # the cwd, so the cd has to happen inside the root shell.
        inner = (
            f"cd {shlex.quote(self.nipe_dir)} && "
            f"{shlex.quote(perl_bin)} {shlex.quote(nipe_script)} {shlex.quote(action)}"
        )

        logger.info("Running: %s %s", pkexec_bin, inner)
        try:
            result = subprocess.run(
                [pkexec_bin, "sh", "-c", inner],
                capture_output=True,
                text=True,
                timeout=180,
            )
        except subprocess.TimeoutExpired:
            return False, f"nipe.pl {action} timed out."
        except OSError as exc:
            logger.error("Command failed: %s", exc)
            return False, str(exc)

        output = _clean_output(result.stdout)
        if result.returncode == 0:
            return True, output or f"nipe.pl {action}: done."

        if result.returncode in (126, 127) or "not authorized" in result.stderr.lower():
            return False, "Authorization was cancelled. The polkit dialog was dismissed."
        return False, _clean_output(result.stderr or result.stdout) or (
            f"nipe.pl {action} failed with exit code {result.returncode}."
        )


def _emit(status: NipeStatus) -> None:
    print(status.to_json())


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="nipe-widget-py",
        description="Nipe Control helper for DankMaterialShell.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    parser_json = subparsers.add_parser("json-status", help="JSON status for the widget")
    parser_json.add_argument("api", nargs="?", default="", help="ipinfo.io-style base URL")
    parser_json.add_argument("--api", dest="api_opt", default="", help="ipinfo.io-style base URL")
    parser_json.add_argument("--nipe-dir", dest="nipe_dir", default="", help="path to nipe.pl")
    parser_json.add_argument("--socks-port", dest="socks_port", type=int, default=0)
    parser_json.add_argument("--check-url", dest="check_url", default="", help="Tor check endpoint")

    for name, help_text in (
        ("status", "run nipe.pl status as root"),
        ("start", "run nipe.pl start as root"),
        ("stop", "run nipe.pl stop as root"),
        ("restart", "run nipe.pl restart as root"),
        ("check-deps", "report dependencies"),
        ("path", "print the resolved Nipe directory"),
    ):
        sub = subparsers.add_parser(name, help=help_text)
        sub.add_argument("--nipe-dir", dest="nipe_dir", default="", help="path to nipe.pl")

    args = parser.parse_args()

    config = NipeConfig()
    if args.command == "json-status":
        api = args.api_opt or args.api
        if api:
            config.ip_info_api = api.rstrip("/")
    if getattr(args, "nipe_dir", ""):
        config.nipe_dir = os.path.expanduser(args.nipe_dir)
    if getattr(args, "socks_port", 0):
        config.tor_socks_port = args.socks_port
    if getattr(args, "check_url", ""):
        config.tor_check_url = args.check_url

    widget = NipeWidgetPy(config)

    try:
        if args.command == "json-status":
            _emit(widget.get_json_status())
        elif args.command in ("status", "start", "stop", "restart"):
            ok, message = widget.run_nipe_cmd(args.command)
            if args.command == "status":
                print(message)
            else:
                print(json.dumps({"action": args.command, "ok": ok, "message": message}))
            return 0 if ok else 1
        elif args.command == "check-deps":
            missing, optional_missing = widget.check_dependencies()
            print("MISSING:" + ", ".join(missing) if missing else "OK")
            if optional_missing:
                print("optional not found: " + ", ".join(optional_missing))
        elif args.command == "path":
            print(widget.nipe_dir or "not_found")
    except Exception as exc:  # noqa: BLE001 - the widget must always get JSON
        logger.exception("Command failed")
        if args.command == "json-status":
            _emit(NipeStatus(error=_clean_output(str(exc))))
        else:
            print(f"[!] ERROR: {_clean_output(str(exc))}")
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
